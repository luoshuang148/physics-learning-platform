# Copy to .env for ./mvnw spring-boot:run (local MySQL, without Docker).
SPRING_PROFILES_ACTIVE=dev
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhixuewuli
DB_USER=root
DB_PASSWORD=replace_with_local_password
APP_JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
SERVER_PORT=8080
VIDEO_STORAGE_PATH=./data/videos

# AI 免费档：只需智谱 Key（https://bigmodel.cn），报告与问答/错题分析均走智谱免费模型。
# 设 AI_ENABLED=true 并把 Key 填到 ZHIPU_AI_API_KEY 即可启用。
AI_ENABLED=false
ZHIPU_AI_API_KEY=
# 可留空；仅当需要单独为报告生成指定其它 Key 时才填写。
ALIYUN_AI_API_KEY=

# 批量学生报告使用 RabbitMQ。本地未启动 RabbitMQ 时可设 REPORT_BATCH_ENABLED=false
# 关闭消费与发件箱调度（页面仍显示入口）；需要联调时执行 docker compose up -d rabbitmq。
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
REPORT_BATCH_ENABLED=true

# 本地知识库检索默认关闭。启用时先运行 docker compose --profile knowledge up -d qdrant。
APP_KNOWLEDGE_ENABLED=false
APP_KNOWLEDGE_QDRANT_URL=http://localhost:6333
AI_LEARNING_ASSISTANT_MODE=WORKFLOW
AI_AGENT_TOOL_CALLING_ENABLED=false
# Keep dynamic tool calling disabled until the target endpoint and budget are verified.
AI_AGENT_BASE_URL=
AI_AGENT_API_KEY=
AI_AGENT_MODEL=
AI_AGENT_TIMEOUT_SECONDS=30

# Optional one-time first teacher provisioning; disable and remove password after startup.
BOOTSTRAP_TEACHER_ENABLED=false
BOOTSTRAP_TEACHER_USERNAME=
BOOTSTRAP_TEACHER_PASSWORD=
