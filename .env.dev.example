# 本地开发/调试示例（请复制为 .env.dev 并按需修改）

# 仍使用容器编排时，建议保留 prod profile + 本地端口映射
SPRING_PROFILES_ACTIVE=prod

# 本地访问端口
PUBLIC_PORT=8080

# 本地调试可使用本地构建镜像或固定标签
APP_IMAGE=zhixuewuli-app:dev
JAVA_OPTS=-Xms256m -Xmx448m -XX:+UseG1GC -XX:+UseContainerSupport

# 数据库（容器网络内）
DB_USER=zhixuewuli_user
DB_PASSWORD=replace_with_local_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=zhixuewuli

# AI Key
ALIYUN_AI_API_KEY=replace_with_local_aliyun_key
ZHIPU_AI_API_KEY=replace_with_local_zhipu_key

# JWT
APP_JWT_SECRET=replace_with_local_jwt_secret

# 本地浏览器来源
APP_CORS_ALLOWED_ORIGIN=http://localhost:8080

# 前端构建参数
VITE_APP_BASE=/api/v1/
VITE_API_BASE_URL=

VIDEO_STORAGE_PATH=/data/videos
SERVER_PORT=8080
