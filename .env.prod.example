# =====================================================
# 智学物理 - 单机生产部署环境变量模板
# 用法：复制为 .env 后按实际值修改
# =====================================================

# 运行环境
SPRING_PROFILES_ACTIVE=prod

# 对外端口（服务器放行该端口，建议 80）
PUBLIC_PORT=80

# 镜像名称（本地 build 后打标签）
APP_IMAGE=zhixuewuli-app:1.0.0

# 容器内 JVM 参数（2C2G 推荐）
JAVA_OPTS=-Xms256m -Xmx448m -XX:+UseG1GC -XX:+UseContainerSupport

# 数据库配置
DB_USER=zhixuewuli_user
DB_PASSWORD=replace_with_strong_password

# CORS 来源（前后端同域时写你的访问域名或公网IP）
APP_CORS_ALLOWED_ORIGIN=http://your-domain-or-ip

# JWT 密钥（建议使用 openssl rand -base64 32 生成）
APP_JWT_SECRET=replace_with_generated_secret

# AI API 密钥
ALIYUN_AI_API_KEY=replace_with_aliyun_key
ZHIPU_AI_API_KEY=replace_with_zhipu_key

# 视频持久化目录（容器内路径）
VIDEO_STORAGE_PATH=/data/videos

# 前端构建时变量（通常无需改）
VITE_APP_BASE=/api/v1/
# 为空表示同域访问后端（推荐）
VITE_API_BASE_URL=

# Optional one-time first teacher provisioning. Disable after the first successful startup.
BOOTSTRAP_TEACHER_ENABLED=false
BOOTSTRAP_TEACHER_USERNAME=
BOOTSTRAP_TEACHER_PASSWORD=

AI_ENABLED=true
