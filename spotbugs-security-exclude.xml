<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 排除测试代码 -->
    <Match>
        <Class name="~.*\.*Test"/>
    </Match>
    
    <!-- 排除测试资源文件 -->
    <Match>
        <Class name="~.*\.test\..*"/>
    </Match>
    
    <!-- 排除生成的代码 -->
    <Match>
        <Class name="~.*\.mapper\..*Impl"/>
    </Match>
    
    <!-- 排除一些低风险的警告 -->
    <Match>
        <BugPattern name="EI_EXPOSE_REP"/>
    </Match>
    
    <Match>
        <BugPattern name="EI_EXPOSE_REP2"/>
    </Match>
    
    <!-- 排除特定包下的警告 -->
    <Match>
        <Package name="~com\.zhixuewuli\.common\.util"/>
        <BugPattern name="DM_DEFAULT_ENCODING"/>
    </Match>
</FindBugsFilter>